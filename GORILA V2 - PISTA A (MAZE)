/*
  ============================================================
  CANDIDATES 2026 - PISTA B (Niveles)  |  Arduino Mega 2560
  ============================================================
  Seccion 1: encontrar la pelota (centro del 3x3), atraparla con la garra
             y llevarla al checkpoint rojo.
  Seccion 2: cruzar la cuadricula verde 2x4 SIN pisar las lineas blancas
             (conservando la pelota).
  Seccion 3: seguir el camino marcado por colores hasta la casilla FIN.

  SUPUESTOS (revisa que coincidan con tu robot):
   - Giroscopio MPU6050 (I2C 0x68). Si es otro, cambia solo la parte GIRO.
   - Sensor de color TCS3200 apuntando al piso, ADELANTE de las ruedas.
   - Motor A = izquierdo, Motor B = derecho (puente H tipo L298N).
   - Garra y su ultrasonico van al FRENTE del robot.
   - El robot inicia en la casilla INICIO, justo debajo de la esquina
     inferior-izquierda del 3x3 y mirando hacia el 3x3 (rumbo 0 = Norte).
   - Seccion 1 tiene paredes exteriores; el checkpoint 1 esta al Este
     de la fila central del 3x3 (como en la Imagen 2.1).
   - NO hay encoders: las distancias se calculan por TIEMPO (calibrar).

  Rumbos (grados, medidos desde el arranque, positivo = giro a la derecha):
     0 = Norte (arriba del mapa)   90 = Este   180 = Sur   270 = Oeste
  ============================================================
*/

#include <Servo.h>
#include <Wire.h>

// ---------- MODOS ----------
#define MODO_CALIBRACION 0   // 1 = menu por Serial para calibrar (NO usar en ronda)

// ---------- PINES ----------
const int CS_OUT = 22, CS_S0 = 23, CS_S1 = 24, CS_S2 = 25, CS_S3 = 26;  // color
const int ENA = 2, IN1 = 27, IN2 = 28, IN3 = 29, IN4 = 30, ENB = 3;     // puente H
const int TRIG_F = 4, ECHO_F = 31;   // ultrasonico frente
const int TRIG_I = 5, ECHO_I = 32;   // izquierda
const int TRIG_D = 6, ECHO_D = 33;   // derecha
const int LED_R = 7, LED_G = 8, LED_B = 9;
const int SERVO_PIN = 10;
const int TRIG_GARRA = 11, ECHO_GARRA = 35;

// ---------- AJUSTES DE MOTORES ----------
const bool INVERTIR_IZQ = false;   // pon true si el motor izquierdo gira al reves
const bool INVERTIR_DER = false;
const int PWM_AVANCE = 150;
const int PWM_LENTO  = 110;        // para buscar lineas/pelota
const int PWM_GIRO_MIN = 85;
const int PWM_GIRO_MAX = 170;
const float CM_S_REF = 20.0;       // cm/s reales a PWM_REF (CALIBRAR)
const int   PWM_REF  = 150;

// ---------- CONTROL DE RUMBO (giroscopio) ----------
const float SIGNO_GIRO = -1.0;     // si al girar a la derecha el rumbo BAJA, cambia a +1.0
const float UMBRAL_RUIDO_DPS = 0.08;
const float KP_RUMBO = 4.0;        // correccion al ir recto
const int   CORR_MAX = 60;
const float KP_GIRO  = 2.5;
const float TOL_GIRO_DEG = 2.0;

// ---------- GEOMETRIA (medir en tu robot) ----------
const float TILE_CM = 30.0;
const float OFFSET_FRENTE_CM = 8.0;   // centro del robot -> cara del ultrasonico frontal
const float MEDIO_ANCHO_CM = 10.0;    // mitad del ancho del robot
const float DIST_PELOTA_CM = 10.0;    // igual que tu codigo de la garra
const float DIST_ABIERTO_CM = 21.5 - OFFSET_FRENTE_CM;  // >esto = lado abierto
const float MAX_ENTRADA_CM = 38.0;    // maximo que avanza dentro de la unidad de la pelota

// ---------- GARRA ----------
const int ANGULO_ABIERTO = 0;
const int ANGULO_CERRADO = 90;

// ---------- SECCION 2 ----------
const float PASO_LATERAL_CM = 4.0;
const float RETRO_LINEA_CM  = 2.0;    // retroceso tras ver la linea
const float PROBE_CM        = RETRO_LINEA_CM + 3.5; // el sensor debe ir >= 6 cm delante de las ruedas
const float CM_IGNORAR_BORDE = 4.0;   // al salir del rojo (borde blanco)
const unsigned long MS_MAX_SEC2 = 15000;

// ---------- SECCION 3 ----------
const float CM_ROJO_A_CENTRO = 15.0 + OFFSET_FRENTE_CM;  // sensor ve rojo -> centro de casilla
const int   MAX_PASOS_S3 = 14;

// ---------- RUMBOS ----------
const float H_N = 0, H_E = 90, H_S = 180, H_O = 270;
const float H_FRENTE_PISTA = H_E;     // "arriba" de la seccion 3 (alejandose del checkpoint)

// ---------- COLORES ----------
enum { COL_BLANCO, COL_ROJO, COL_VERDE, COL_VERDE_FIN, COL_CIAN,
       COL_AMARILLO, COL_NARANJA, COL_ROSA, COL_NINGUNO };
const int N_REF = 8;
const char* NOMBRE_COL[] = {"BLANCO", "ROJO", "VERDE", "VERDE_FIN", "CIAN",
                            "AMARILLO", "NARANJA", "ROSA", "NINGUNO"};

// Anchura de pulso (us) del sensor sobre una casilla BLANCA -> da el balance de blancos.
// CALIBRAR con el modo calibracion.
float BLANCO_R_US = 60, BLANCO_G_US = 60, BLANCO_B_US = 70;

// Valores normalizados (R,G,B respecto al blanco) de cada color. CALIBRAR.
const float REF[N_REF][3] = {
  {1.00, 1.00, 1.00},   // BLANCO
  {0.60, 0.12, 0.12},   // ROJO
  {0.12, 0.40, 0.18},   // VERDE (piso seccion 2)
  {0.50, 0.85, 0.30},   // VERDE_FIN (casilla final)
  {0.25, 0.75, 0.90},   // CIAN     = derecha
  {0.95, 0.90, 0.20},   // AMARILLO = izquierda
  {0.95, 0.50, 0.15},   // NARANJA  = arriba
  {0.90, 0.35, 0.60}    // ROSA     = abajo
};
const float UMBRAL_DIST2 = 0.15;

unsigned long pulR = 0, pulG = 0, pulB = 0;   // ultimos pulsos crudos

// ---------- ESTADO GLOBAL ----------
Servo garra;
const uint8_t MPU_ADDR = 0x68;
float rumbo = 0;               // rumbo actual medido (0..360)
float sesgoGiro = 0;
unsigned long tGiroPrev = 0;

const byte EV_BLANCO = 1, EV_ROJO = 2, EV_PELOTA = 4, EV_FRENTE = 8, EV_NOROJO = 16;
byte evento = 0;               // que condicion detuvo el ultimo movimiento
unsigned long msRec = 0;       // duracion del ultimo movimiento
bool rondaTerminada = false;

// ============================================================
//  UTILIDADES
// ============================================================
void led(bool r, bool g, bool b) {
  digitalWrite(LED_R, r); digitalWrite(LED_G, g); digitalWrite(LED_B, b);
}

float normaliza(float a) {
  while (a >= 360) a -= 360;
  while (a < 0) a += 360;
  return a;
}

float errorAngulo(float objetivo) {     // + => hay que girar a la derecha
  float e = objetivo - rumbo;
  while (e > 180) e -= 360;
  while (e <= -180) e += 360;
  return e;
}

// ============================================================
//  GIROSCOPIO (MPU6050, eje Z)
// ============================================================
bool leerGyroZRaw(int16_t &raw) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x47);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((int)MPU_ADDR, 2, (int)true) != 2) return false;
  uint8_t h = Wire.read();
  uint8_t l = Wire.read();
  raw = (int16_t)((h << 8) | l);
  return true;
}

void iniciarGiro() {
  Wire.begin();
  Wire.setClock(400000);
  Wire.beginTransmission(MPU_ADDR); Wire.write(0x6B); Wire.write(0x00); Wire.endTransmission(); // despertar
  Wire.beginTransmission(MPU_ADDR); Wire.write(0x1A); Wire.write(0x03); Wire.endTransmission(); // filtro
  Wire.beginTransmission(MPU_ADDR); Wire.write(0x1B); Wire.write(0x00); Wire.endTransmission(); // +-250 dps
  delay(100);
}

void calibrarGiro() {                   // robot COMPLETAMENTE quieto
  long suma = 0; int n = 0;
  for (int i = 0; i < 800; i++) {
    int16_t raw;
    if (leerGyroZRaw(raw)) { suma += raw; n++; }
    delay(2);
  }
  sesgoGiro = (n > 0) ? (float)suma / n : 0;
  rumbo = 0;
  tGiroPrev = micros();
}

void actualizarGiro() {                 // llamar MUY seguido
  unsigned long ahora = micros();
  float dt = (ahora - tGiroPrev) / 1000000.0f;
  tGiroPrev = ahora;
  int16_t raw;
  if (!leerGyroZRaw(raw)) return;
  float dps = ((float)raw - sesgoGiro) / 131.0f;
  if (fabs(dps) < UMBRAL_RUIDO_DPS) return;
  rumbo = normaliza(rumbo + SIGNO_GIRO * dps * dt);
}

void pausaConGiro(unsigned long ms) {
  unsigned long t = millis();
  while (millis() - t < ms) actualizarGiro();
}

// ============================================================
//  MOTORES
// ============================================================
void motorIzq(int v) {
  v = constrain(v, -255, 255);
  if (INVERTIR_IZQ) v = -v;
  if (v > 0)      { digitalWrite(IN1, HIGH); digitalWrite(IN2, LOW); }
  else if (v < 0) { digitalWrite(IN1, LOW);  digitalWrite(IN2, HIGH); }
  else            { digitalWrite(IN1, LOW);  digitalWrite(IN2, LOW); }
  analogWrite(ENA, abs(v));
}

void motorDer(int v) {
  v = constrain(v, -255, 255);
  if (INVERTIR_DER) v = -v;
  if (v > 0)      { digitalWrite(IN3, HIGH); digitalWrite(IN4, LOW); }
  else if (v < 0) { digitalWrite(IN3, LOW);  digitalWrite(IN4, HIGH); }
  else            { digitalWrite(IN3, LOW);  digitalWrite(IN4, LOW); }
  analogWrite(ENB, abs(v));
}

void motores(int izq, int der) { motorIzq(izq); motorDer(der); }

void detener() {                        // freno corto y suelta
  digitalWrite(IN1, HIGH); digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH); digitalWrite(IN4, HIGH);
  analogWrite(ENA, 255); analogWrite(ENB, 255);
  unsigned long t = millis();
  while (millis() - t < 60) actualizarGiro();
  motores(0, 0);
}

// ============================================================
//  ULTRASONICOS
// ============================================================
float leerCm(int trig, int echo) {
  digitalWrite(trig, LOW);  delayMicroseconds(2);
  digitalWrite(trig, HIGH); delayMicroseconds(10);
  digitalWrite(trig, LOW);
  unsigned long d = pulseIn(echo, HIGH, 15000);
  if (d == 0) return 400.0;
  return d * 0.0343f / 2.0f;
}

float leerCmMediana(int trig, int echo) {
  float v[5];
  for (int i = 0; i < 5; i++) {
    v[i] = leerCm(trig, echo);
    pausaConGiro(25);
  }
  for (int i = 0; i < 4; i++)
    for (int j = i + 1; j < 5; j++)
      if (v[j] < v[i]) { float t = v[i]; v[i] = v[j]; v[j] = t; }
  return v[2];
}

// ============================================================
//  SENSOR DE COLOR (TCS3200)
// ============================================================
unsigned long leerPulso(bool s2, bool s3) {
  digitalWrite(CS_S2, s2); digitalWrite(CS_S3, s3);
  delayMicroseconds(800);
  return pulseIn(CS_OUT, LOW, 8000);    // 0 = sin senal (muy oscuro)
}

float aIntensidad(unsigned long pulso, float blancoUs) {
  if (pulso == 0) return 0;
  float v = blancoUs / (float)pulso;
  return (v > 1.5) ? 1.5 : v;
}

void leerRGBNorm(float &r, float &g, float &b) {
  pulR = leerPulso(LOW, LOW);
  pulG = leerPulso(HIGH, HIGH);
  pulB = leerPulso(LOW, HIGH);
  r = aIntensidad(pulR, BLANCO_R_US);
  g = aIntensidad(pulG, BLANCO_G_US);
  b = aIntensidad(pulB, BLANCO_B_US);
}

int clasificarColor() {
  float r, g, b;
  leerRGBNorm(r, g, b);
  int mejor = COL_NINGUNO;
  float dmin = 1e9;
  for (int i = 0; i < N_REF; i++) {
    float dr = r - REF[i][0], dg = g - REF[i][1], db = b - REF[i][2];
    float d = dr * dr + dg * dg + db * db;
    if (d < dmin) { dmin = d; mejor = i; }
  }
  if (dmin > UMBRAL_DIST2) return COL_NINGUNO;
  return mejor;
}

int colorEstable() {                    // dos lecturas iguales seguidas
  int previo = clasificarColor();
  for (int i = 0; i < 6; i++) {
    int c = clasificarColor();
    if (c == previo) return c;
    previo = c;
  }
  return previo;
}

// ============================================================
//  GARRA
// ============================================================
void abrirGarra()  { garra.write(ANGULO_ABIERTO); pausaConGiro(500); }
void cerrarGarra() { garra.write(ANGULO_CERRADO); pausaConGiro(700); }  // y se queda cerrada

bool pelotaEnGarra() { return leerCm(TRIG_GARRA, ECHO_GARRA) <= DIST_PELOTA_CM + 3; }

// ============================================================
//  MOVIMIENTO CON GIROSCOPIO
// ============================================================
unsigned long msParaCm(float cm, int pwm) {
  float v = CM_S_REF * (float)abs(pwm) / (float)PWM_REF;   // cm/s
  return (unsigned long)(fabs(cm) / v * 1000.0f);
}

// Avanza (pwmBase>0) o retrocede (pwmBase<0) manteniendo el rumbo con el giroscopio.
// Se detiene por tiempo o si ocurre alguna condicion de 'vigilar'.
// Devuelve true si se detuvo por una condicion (ver variable 'evento').
bool mover(float rumboObj, int pwmBase, unsigned long maxMs, byte vigilar, float frenteMin) {
  evento = 0;
  int cB = 0, cR = 0, cN = 0, cP = 0;
  unsigned long t0 = millis();
  while (millis() - t0 < maxMs) {
    actualizarGiro();
    float e = errorAngulo(rumboObj);
    int corr = constrain((int)(KP_RUMBO * e), -CORR_MAX, CORR_MAX);
    motores(pwmBase + corr, pwmBase - corr);   // e>0 => gira a la derecha

    if (vigilar & (EV_BLANCO | EV_ROJO | EV_NOROJO)) {
      int c = clasificarColor();
      cB = (c == COL_BLANCO) ? cB + 1 : 0;
      cR = (c == COL_ROJO)   ? cR + 1 : 0;
      cN = (c != COL_ROJO)   ? cN + 1 : 0;
      if ((vigilar & EV_BLANCO) && cB >= 2) { evento = EV_BLANCO; break; }
      if ((vigilar & EV_ROJO)   && cR >= 2) { evento = EV_ROJO;   break; }
      if ((vigilar & EV_NOROJO) && cN >= 2) { evento = EV_NOROJO; break; }
    }
    if (vigilar & EV_PELOTA) {
      float d = leerCm(TRIG_GARRA, ECHO_GARRA);
      cP = (d <= DIST_PELOTA_CM) ? cP + 1 : 0;
      if (cP >= 2) { evento = EV_PELOTA; break; }
    }
    if (vigilar & EV_FRENTE) {
      if (leerCm(TRIG_F, ECHO_F) <= frenteMin) { evento = EV_FRENTE; break; }
    }
  }
  msRec = millis() - t0;
  detener();
  return evento != 0;
}

void avanzarCm(float rumboObj, float cm) {
  mover(rumboObj, PWM_AVANCE, msParaCm(cm, PWM_AVANCE), 0, 0);
}
void retrocederCm(float rumboObj, float cm) {
  mover(rumboObj, -PWM_AVANCE, msParaCm(cm, PWM_AVANCE), 0, 0);
}
void avanzarLentoCm(float rumboObj, float cm) {
  mover(rumboObj, PWM_LENTO, msParaCm(cm, PWM_LENTO), 0, 0);
}

void girarA(float objetivo) {
  unsigned long t0 = millis(), tEstable = 0;
  while (millis() - t0 < 5000) {
    actualizarGiro();
    float e = errorAngulo(objetivo);
    if (fabs(e) <= TOL_GIRO_DEG) {
      motores(0, 0);
      if (tEstable == 0) tEstable = millis();
      if (millis() - tEstable >= 120) break;
    } else {
      tEstable = 0;
      int pwm = constrain((int)(fabs(e) * KP_GIRO), PWM_GIRO_MIN, PWM_GIRO_MAX);
      if (e > 0) motores(pwm, -pwm);     // girar a la derecha
      else       motores(-pwm, pwm);     // girar a la izquierda
    }
  }
  detener();
}

void irCasilla(float rumboObj) {         // gira y avanza una unidad
  girarA(rumboObj);
  avanzarCm(rumboObj, TILE_CM);
}

// ============================================================
//  SECCION 1: pelota escondida en el centro del 3x3
//  Casillas (columna,fila): fila 0 = norte, fila 2 = sur. Centro = (1,1).
//  Inicio: debajo de (0,2). Se revisan las 4 vecinas del centro.
// ============================================================
bool hayAbertura() {
  pausaConGiro(150);
  return leerCmMediana(TRIG_F, ECHO_F) > DIST_ABIERTO_CM;
}

void capturarPelota(float rumboObj) {
  girarA(rumboObj);
  abrirGarra();
  mover(rumboObj, PWM_LENTO, msParaCm(MAX_ENTRADA_CM, PWM_LENTO), EV_PELOTA, 0);
  unsigned long msEntrada = msRec;
  cerrarGarra();                         // se queda cerrada hasta el final
  if (pelotaEnGarra()) led(0, 1, 0); else led(1, 0, 0);
  mover(rumboObj, -PWM_LENTO, msEntrada, 0, 0);   // sale de la unidad (misma distancia)
}

void seccion1() {
  led(0, 0, 1);
  abrirGarra();

  irCasilla(H_N);                        // INICIO -> (0,2)
  irCasilla(H_E);                        // -> (1,2) vecina SUR del centro
  girarA(H_N);

  int lado;                              // 0=sur 1=oeste 2=norte 3=este (lado abierto)
  if (hayAbertura()) {
    lado = 0;
    capturarPelota(H_N);
  } else {
    irCasilla(H_O);                      // -> (0,2)
    irCasilla(H_N);                      // -> (0,1) vecina OESTE
    girarA(H_E);
    if (hayAbertura()) {
      lado = 1;
      capturarPelota(H_E);
    } else {
      irCasilla(H_N);                    // -> (0,0)
      irCasilla(H_E);                    // -> (1,0) vecina NORTE
      girarA(H_S);
      if (hayAbertura()) {
        lado = 2;
        capturarPelota(H_S);
      } else {                           // por eliminacion: lado ESTE
        irCasilla(H_E);                  // -> (2,0)
        irCasilla(H_S);                  // -> (2,1) vecina ESTE
        lado = 3;
        capturarPelota(H_O);
      }
    }
  }

  // Ir a (2,1) con la pelota
  if (lado == 0) { irCasilla(H_E); irCasilla(H_N); }
  else if (lado == 1) { irCasilla(H_S); irCasilla(H_E); irCasilla(H_E); irCasilla(H_N); }
  else if (lado == 2) { irCasilla(H_E); irCasilla(H_S); }
  // lado 3: ya esta en (2,1)

  girarA(H_E);
  mover(H_E, PWM_LENTO, 6000, EV_ROJO, 0);   // hasta el checkpoint 1
}

// ============================================================
//  SECCION 2: lineas blancas
// ============================================================
bool pasoLateral(float rumboLado) {      // false si hay pared
  girarA(rumboLado);
  float r = leerCmMediana(TRIG_F, ECHO_F);
  if ((r + OFFSET_FRENTE_CM) - PASO_LATERAL_CM < MEDIO_ANCHO_CM + 1.0) {
    girarA(H_E);
    return false;
  }
  avanzarCm(rumboLado, PASO_LATERAL_CM);
  girarA(H_E);
  return true;
}

void lateralCm(float rumboLado, float cm) {
  if (cm < 0.5) return;
  girarA(rumboLado);
  avanzarCm(rumboLado, cm);
  girarA(H_E);
}

// true = hay linea justo adelante. El sensor solo avanza unos cm (las ruedas NO llegan a la linea).
bool sondear() {
  bool b = mover(H_E, PWM_LENTO, msParaCm(PROBE_CM, PWM_LENTO), EV_BLANCO, 0);
  unsigned long ms = msRec;
  mover(H_E, -PWM_LENTO, ms, 0, 0);
  return b;
}

// Devuelve true si resulto ser el borde del checkpoint (se llego al rojo).
bool resolverLinea() {
  // 1) Puede ser el borde blanco antes del rojo: avanzar poquito vigilando rojo
  if (mover(H_E, PWM_LENTO, msParaCm(4.0, PWM_LENTO), EV_ROJO, 0)) return true;
  unsigned long ms = msRec + msParaCm(RETRO_LINEA_CM, PWM_LENTO);
  mover(H_E, -PWM_LENTO, ms, 0, 0);

  // 2) Barrer lateralmente hacia donde hay mas espacio hasta encontrar el hueco
  float dI = leerCmMediana(TRIG_I, ECHO_I);
  float dD = leerCmMediana(TRIG_D, ECHO_D);
  float d  = (dI >= dD) ? H_N : H_S;     // mirando al Este: izquierda=Norte, derecha=Sur
  bool cambio = false;
  int intentos = 0;

  while (sondear()) {                    // bloqueado
    if (!pasoLateral(d)) {
      if (cambio) { led(1, 0, 0); return false; }   // sin salida
      cambio = true;
      d = normaliza(d + 180);
    }
    if (++intentos > 24) return false;
  }

  // 3) Medir el ancho libre y centrarse
  float opuesto = normaliza(d + 180);
  int libres = 1;
  while (libres < 14) {
    if (!pasoLateral(d)) break;          // pared = borde del hueco
    if (sondear()) { pasoLateral(opuesto); break; }
    libres++;
  }
  lateralCm(opuesto, (libres - 1) * PASO_LATERAL_CM / 2.0);
  return false;
}

void seccion2() {
  led(1, 1, 0);
  mover(H_E, PWM_LENTO, 4000, EV_NOROJO, 0);      // salir del checkpoint rojo
  avanzarLentoCm(H_E, CM_IGNORAR_BORDE);          // ignorar borde blanco

  for (int lineas = 0; lineas < 8; lineas++) {
    bool hit = mover(H_E, PWM_LENTO, MS_MAX_SEC2, EV_BLANCO | EV_ROJO, 0);
    if (!hit || evento == EV_ROJO) break;
    if (resolverLinea()) break;
  }
}

// ============================================================
//  SECCION 3: camino por colores
// ============================================================
float rumboDeColor(int c) {              // -1 = color sin instruccion
  switch (c) {
    case COL_NARANJA:  return normaliza(H_FRENTE_PISTA);          // arriba
    case COL_CIAN:     return normaliza(H_FRENTE_PISTA + 90);     // derecha
    case COL_AMARILLO: return normaliza(H_FRENTE_PISTA - 90);     // izquierda
    case COL_ROSA:     return normaliza(H_FRENTE_PISTA + 180);    // abajo
  }
  return -1;
}

void finRonda() {
  detener();
  led(0, 1, 0);
  rondaTerminada = true;                 // la garra sigue cerrada con la pelota
}

void seccion3() {
  led(1, 0, 1);
  float rumboAct = H_FRENTE_PISTA;
  girarA(rumboAct);
  avanzarCm(rumboAct, CM_ROJO_A_CENTRO); // centro del checkpoint
  avanzarCm(rumboAct, TILE_CM);          // centro de la primera casilla

  for (int paso = 0; paso < MAX_PASOS_S3; paso++) {
    int c = colorEstable();
    for (int i = 0; i < 3 && c != COL_VERDE_FIN && rumboDeColor(c) < 0; i++) {
      retrocederCm(rumboAct, 3.0);       // reubicar y volver a leer
      c = colorEstable();
    }
    if (c == COL_VERDE_FIN) { finRonda(); return; }

    float dir = rumboDeColor(c);
    if (dir < 0) { led(1, 0, 0); detener(); return; }   // color desconocido
    girarA(dir);
    avanzarCm(dir, TILE_CM);
    rumboAct = dir;
  }
  detener();
}

// ============================================================
//  MODO CALIBRACION (Serial 9600). Comandos:
//   z=poner rumbo en 0   a=avanzar 2 s recto   g=girar +90
//   o=abrir garra        c=cerrar garra
// ============================================================
void modoCalibracion() {
  Serial.println(F("=== MODO CALIBRACION ==="));
  unsigned long t = 0;
  while (true) {
    actualizarGiro();
    if (Serial.available()) {
      char c = Serial.read();
      if (c == 'z') rumbo = 0;
      else if (c == 'a') mover(rumbo, PWM_AVANCE, 2000, 0, 0);
      else if (c == 'g') girarA(normaliza(rumbo + 90));
      else if (c == 'o') abrirGarra();
      else if (c == 'c') cerrarGarra();
    }
    if (millis() - t > 400) {
      t = millis();
      float r, g, b;
      leerRGBNorm(r, g, b);
      int col = clasificarColor();
      Serial.print(F("Rumbo ")); Serial.print(rumbo, 1);
      Serial.print(F(" | F ")); Serial.print(leerCm(TRIG_F, ECHO_F), 1);
      Serial.print(F(" I ")); Serial.print(leerCm(TRIG_I, ECHO_I), 1);
      Serial.print(F(" D ")); Serial.print(leerCm(TRIG_D, ECHO_D), 1);
      Serial.print(F(" Garra ")); Serial.print(leerCm(TRIG_GARRA, ECHO_GARRA), 1);
      Serial.print(F(" | pulsos R,G,B: ")); Serial.print(pulR); Serial.print(',');
      Serial.print(pulG); Serial.print(','); Serial.print(pulB);
      Serial.print(F(" | norm: ")); Serial.print(r, 2); Serial.print(',');
      Serial.print(g, 2); Serial.print(','); Serial.print(b, 2);
      Serial.print(F(" -> ")); Serial.println(NOMBRE_COL[col]);
    }
  }
}

// ============================================================
//  SETUP / LOOP
// ============================================================
void setup() {
  Serial.begin(9600);

  pinMode(ENA, OUTPUT); pinMode(ENB, OUTPUT);
  pinMode(IN1, OUTPUT); pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT); pinMode(IN4, OUTPUT);

  pinMode(TRIG_F, OUTPUT); pinMode(ECHO_F, INPUT);
  pinMode(TRIG_I, OUTPUT); pinMode(ECHO_I, INPUT);
  pinMode(TRIG_D, OUTPUT); pinMode(ECHO_D, INPUT);
  pinMode(TRIG_GARRA, OUTPUT); pinMode(ECHO_GARRA, INPUT);

  pinMode(CS_S0, OUTPUT); pinMode(CS_S1, OUTPUT);
  pinMode(CS_S2, OUTPUT); pinMode(CS_S3, OUTPUT);
  pinMode(CS_OUT, INPUT);
  digitalWrite(CS_S0, HIGH); digitalWrite(CS_S1, LOW);   // escala de frecuencia 20 %

  pinMode(LED_R, OUTPUT); pinMode(LED_G, OUTPUT); pinMode(LED_B, OUTPUT);
  led(1, 0, 0);

  garra.attach(SERVO_PIN);
  garra.write(ANGULO_ABIERTO);

  iniciarGiro();
  delay(800);                            // robot quieto
  calibrarGiro();
  led(0, 0, 0);

#if MODO_CALIBRACION
  modoCalibracion();
#endif
}

void loop() {
  if (!rondaTerminada) {
    seccion1();
    seccion2();
    seccion3();
    rondaTerminada = true;
  }
  motores(0, 0);                         // fin: garra cerrada, robot detenido
}
