#include <Wire.h>

// ===================================================
// MAPEO DE PINES PARA ARDUINO MEGA 2560
// ===================================================

// Sensor de Color (TCS3200)
const int COLOR_OUT = 22;
const int COLOR_S0  = 23;
const int COLOR_S1  = 24;
const int COLOR_S2  = 25;
const int COLOR_S3  = 26;

// Puente H (L298N)
const int ENA = 2;   // PWM Motor Izquierdo
const int IN1 = 27;  // Dirección Motor Izquierdo
const int IN2 = 28;  // Dirección Motor Izquierdo
const int IN3 = 29;  // Dirección Motor Derecho
const int IN4 = 30;  // Dirección Motor Derecho
const int ENB = 3;   // PWM Motor Derecho

// Sensores Ultrasónicos (HC-SR04)
const int TRIG_FRENTE = 4;
const int ECHO_FRENTE = 31;

const int TRIG_IZQ = 5;
const int ECHO_IZQ = 32;

const int TRIG_DER = 6;
const int ECHO_DER = 33;

// Giroscopio (MPU6050 via I2C: SDA=20, SCL=21)
const int GYRO_INT = 34; 
const int MPU_ADDR = 0x68;

// Indicador Visual - LED RGB (Cátodo Común)
const int LED_R = 7;
const int LED_G = 8;
const int LED_B = 9;

// ===================================================
// PARÁMETROS DE NAVEGACIÓN Y CALIBRACIÓN
// ===================================================
int velIzquierda = 200; 
int velDerecha   = 180; 

// Umbral de reacción ajustado exactamente a 15 cm
const int UMBRAL_OBSTACULO = 15; 

// Calibración TCS3200
int redMin = 30;    int redMax = 200;
int greenMin = 32;  int greenMax = 220;
int blueMin = 28;   int blueMax = 190;

int R, G, B;
int distFrente = 0, distIzq = 0, distDer = 0;

// ===================================================
// BRÚJULA Y GIROSCOPIO (SISTEMA INTEGRADO DE ORIENTACIÓN)
// ===================================================
float gyroZOffset = 0;
float anguloActual = 0.0; // Ángulo acumulado continuo en grados
unsigned long ultimoTiempoGyro = 0;

// 0: NORTE (0°), 1: ESTE (90°), 2: SUR (180°), 3: OESTE (270°)
int orientacionActual = 0; 
const char* NOMBRES_RUMBO[] = {"NORTE (0°)", "ESTE (90°)", "SUR (180°)", "OESTE (270°)"};

void setup() {
  Serial.begin(9600);
  Wire.begin();

  // 1. Configuración Puente H
  pinMode(ENA, OUTPUT); pinMode(ENB, OUTPUT);
  pinMode(IN1, OUTPUT); pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT); pinMode(IN4, OUTPUT);

  // 2. Configuración Sensor de Color
  pinMode(COLOR_OUT, INPUT);
  pinMode(COLOR_S0, OUTPUT); pinMode(COLOR_S1, OUTPUT);
  pinMode(COLOR_S2, OUTPUT); pinMode(COLOR_S3, OUTPUT);
  digitalWrite(COLOR_S0, HIGH);
  digitalWrite(COLOR_S1, LOW);

  // 3. Configuración Sensores Ultrasónicos
  pinMode(TRIG_FRENTE, OUTPUT); pinMode(ECHO_FRENTE, INPUT);
  pinMode(TRIG_IZQ, OUTPUT);    pinMode(ECHO_IZQ, INPUT);
  pinMode(TRIG_DER, OUTPUT);    pinMode(ECHO_DER, INPUT);

  digitalWrite(TRIG_FRENTE, LOW);
  digitalWrite(TRIG_IZQ, LOW);
  digitalWrite(TRIG_DER, LOW);

  // 4. Configuración y Calibración del MPU6050 (Brújula Gyro)
  pinMode(GYRO_INT, INPUT);
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B); // Despertar MPU6050
  Wire.write(0);    
  Wire.endTransmission(true);

  // Calibración estática del giroscopio
  calibrarGiroscopio();
  ultimoTiempoGyro = millis();

  // 5. Configuración LED RGB
  pinMode(LED_R, OUTPUT);
  pinMode(LED_G, OUTPUT);
  pinMode(LED_B, OUTPUT);
  mostrarColorRGB(0, 0, 0);

  detener();
}

void loop() {
  // Integración continua del Giroscopio para no perder rumbo
  actualizarAnguloGyro();

  // 1. Medir distancias ultrasónicas
  distFrente = medirDistancia(TRIG_FRENTE, ECHO_FRENTE);
  distIzq    = medirDistancia(TRIG_IZQ, ECHO_IZQ);
  distDer    = medirDistancia(TRIG_DER, ECHO_DER);

  // 2. Identificación de color e iluminación del LED RGB
  String colorDetectado = obtenerColor();
  actualizarLEDColor(colorDetectado);

  String estadoMovimiento = "";

  // ===================================================
  // 4. LÓGICA DE NAVEGACIÓN Y BRÚJULA (RECONSTRUIDA DESDE CERO)
  // ===================================================

  // CASO 1: VÍA LIBRE ENFRENTE (>= 15 cm) -> Siempre avanza recto
  if (distFrente >= UMBRAL_OBSTACULO) {
    estadoMovimiento = "AVANZANDO RECTO - RUMBO: " + String(NOMBRES_RUMBO[orientacionActual]);
    adelante(velIzquierda, velDerecha);
  } 
  // CASO 2: OBSTÁCULO/PARED ENFRENTE (< 15 cm)
  else {
    detener();
    delay(100);

    // Subcaso 2.1: Bloqueado Frente Y Bloqueado Derecha -> Girar A LA IZQUIERDA (-90°)
    if (distDer < UMBRAL_OBSTACULO && distIzq >= UMBRAL_OBSTACULO) {
      estadoMovimiento = "OBSTÁCULO FRENTE Y DERECHA -> GIRANDO IZQUIERDA";
      imprimirEstadoConsolidado(estadoMovimiento, colorDetectado);
      
      girarConBrujula(-1); // Giro de -90° (Izquierda)
    } 
    // Subcaso 2.2: Bloqueado Frente Y Bloqueado Izquierda -> Girar A LA DERECHA (+90°)
    else if (distIzq < UMBRAL_OBSTACULO && distDer >= UMBRAL_OBSTACULO) {
      estadoMovimiento = "OBSTÁCULO FRENTE E IZQUIERDA -> GIRANDO DERECHA";
      imprimirEstadoConsolidado(estadoMovimiento, colorDetectado);
      
      girarConBrujula(1); // Giro de +90° (Derecha)
    } 
    // Subcaso 2.3: Bloqueado Frente PERO Izquierda y Derecha LIBRES -> Prioridad Giro Derecha (+90°)
    else if (distIzq >= UMBRAL_OBSTACULO && distDer >= UMBRAL_OBSTACULO) {
      estadoMovimiento = "OBSTÁCULO FRENTE (LATERALES LIBRES) -> GIRANDO DERECHA";
      imprimirEstadoConsolidado(estadoMovimiento, colorDetectado);
      
      girarConBrujula(1); // Giro de +90° (Derecha)
    } 
    // Subcaso 2.4: Callejón sin salida (Frente, Derecha e Izquierda BLOQUEADOS < 15 cm) -> Retorno 180°
    else {
      estadoMovimiento = "CALLEJÓN SIN SALIDA -> RETROCEDIENDO Y GIRO 180°";
      imprimirEstadoConsolidado(estadoMovimiento, colorDetectado);
      
      atras(velIzquierda, velDerecha);
      delay(300);
      detener();
      girarConBrujula(2); // Giro de 180°
    }
  }

  // Monitor serie consolidado
  imprimirEstadoConsolidado(estadoMovimiento, colorDetectado);
  delay(40);
}

// ===================================================
// NAVEGACIÓN ASISTIDA POR GIROSCÓPIO / BRÚJULA
// ===================================================

// Función para ejecutar giros exactos de 90° / 180° validados por el giroscopio
void girarConBrujula(int cambioOrientacion) {
  // cambioOrientacion: +1 = Derecha (+90°), -1 = Izquierda (-90°), +2 = Media Vuelta (180°)
  float anguloInicio = anguloActual;
  float gradosTarget = cambioOrientacion * 90.0;
  float anguloObjetivo = anguloInicio + gradosTarget;

  if (cambioOrientacion > 0) {
    girarDerecha(velIzquierda, velDerecha);
  } else {
    girarIzquierda(velIzquierda, velDerecha);
  }

  // Bucle de retroalimentación cerrada del giroscopio
  unsigned long tiempoTimeout = millis();
  while (abs(anguloActual - anguloObjetivo) > 3.0) {
    actualizarAnguloGyro();

    // Seguridad por si las ruedas patinan (máximo 2.5 segundos por giro)
    if (millis() - tiempoTimeout > 2500) break; 
    delay(5);
  }

  detener();
  delay(100);

  // Actualizar la orientación cardinal de la brújula (N, E, S, O)
  orientacionActual = (orientacionActual + cambioOrientacion + 4) % 4;
}

// Muestra e integra las lecturas del giroscopio (eje Z)
void actualizarAnguloGyro() {
  unsigned long tiempoActual = millis();
  float dt = (tiempoActual - ultimoTiempoGyro) / 1000.0;
  ultimoTiempoGyro = tiempoActual;

  int16_t rawZ = leerGyroZRaw();
  float velocidadZ = (rawZ - gyroZOffset) / 131.0; // Conversión a grados/segundo (rango ±250 deg/s)

  // Filtro de ruido
  if (abs(velocidadZ) > 0.8) {
    anguloActual += velocidadZ * dt;
  }
}

void calibrarGiroscopio() {
  long sumaZ = 0;
  for (int i = 0; i < 500; i++) {
    sumaZ += leerGyroZRaw();
    delay(2);
  }
  gyroZOffset = sumaZ / 500.0;
}

int16_t leerGyroZRaw() {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x47); // Registro Z-Gyro Output
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, 2, true);
  if (Wire.available() >= 2) {
    return (Wire.read() << 8 | Wire.read());
  }
  return 0;
}

// ===================================================
// CONTROL DEL LED RGB
// ===================================================
void mostrarColorRGB(int r, int g, int b) {
  analogWrite(LED_R, r);
  analogWrite(LED_G, g);
  analogWrite(LED_B, b);
}

void actualizarLEDColor(String color) {
  if (color == "CELESTE")       mostrarColorRGB(0, 255, 255);
  else if (color == "AMARILLO") mostrarColorRGB(255, 255, 0);
  else if (color == "NARANJA")  mostrarColorRGB(255, 80, 0);
  else if (color == "ROSA")     mostrarColorRGB(255, 20, 147);
  else if (color == "VERDE")    mostrarColorRGB(0, 255, 0);
  else if (color == "ROJO")     mostrarColorRGB(255, 0, 0);
  else                          mostrarColorRGB(0, 0, 0);
}

// ===================================================
// LECTURA DE SENSOR DE COLOR (TCS3200)
// ===================================================
String obtenerColor() {
  digitalWrite(COLOR_S2, LOW); digitalWrite(COLOR_S3, LOW);
  R = constrain(map(pulseIn(COLOR_OUT, LOW, 20000), redMin, redMax, 255, 0), 0, 255);

  digitalWrite(COLOR_S2, HIGH); digitalWrite(COLOR_S3, HIGH);
  G = constrain(map(pulseIn(COLOR_OUT, LOW, 20000), greenMin, greenMax, 255, 0), 0, 255);

  digitalWrite(COLOR_S2, LOW); digitalWrite(COLOR_S3, HIGH);
  B = constrain(map(pulseIn(COLOR_OUT, LOW, 20000), blueMin, blueMax, 255, 0), 0, 255);

  float r = R / 255.0, g = G / 255.0, b = B / 255.0;
  float cmax = max(r, max(g, b)), cmin = min(r, min(g, b));
  float delta = cmax - cmin;
  float H = 0, S = 0, V = cmax * 100.0;

  if (delta != 0) {
    if (cmax == r) H = 60.0 * fmod(((g - b) / delta), 6.0);
    else if (cmax == g) H = 60.0 * (((b - r) / delta) + 2.0);
    else if (cmax == b) H = 60.0 * (((r - g) / delta) + 4.0);
    if (H < 0) H += 360.0;
    S = (delta / cmax) * 100.0;
  }

  if (V < 18) return "NEGRO";
  if (S < 20) return (V > 65) ? "BLANCO" : "GRIS";

  if (H >= 345 || H < 12) return "ROJO";
  if (H >= 12 && H < 38)  return "NARANJA";
  if (H >= 38 && H < 68)  return "AMARILLO";
  if (H >= 68 && H < 150) return "VERDE";
  if (H >= 150 && H < 205) return "CELESTE";
  if (H >= 205 && H < 260) return "AZUL";
  if (H >= 260 && H < 345) return "ROSA";

  return "INDEFINIDO";
}

// ===================================================
// LECTURA DE ULTRASÓNICOS
// ===================================================
int medirDistancia(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(5);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 25000);
  if (duration == 0) return 400;
  return duration * 0.034 / 2;
}

// ===================================================
// MONITOR SERIAL CONSOLIDADO
// ===================================================
void imprimirEstadoConsolidado(String mov, String col) {
  Serial.print("Movimiento: "); Serial.print(mov);
  Serial.print(" | Brújula: "); Serial.print(NOMBRES_RUMBO[orientacionActual]);
  Serial.print(" ("); Serial.print(anguloActual); Serial.print("°)");
  Serial.print(" | Color: "); Serial.print(col);
  Serial.print(" | Dist(cm) -> F: "); Serial.print(distFrente);
  Serial.print(", I: "); Serial.print(distIzq);
  Serial.print(", D: "); Serial.println(distDer);
}

// ===================================================
// CONTROL DE MOTORES (POLARIDAD INVERTIDA CORREGIDA)
// ===================================================
void adelante(int vIzq, int vDer) {
  analogWrite(ENA, vIzq); analogWrite(ENB, vDer);
  digitalWrite(IN1, LOW);  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);  digitalWrite(IN4, HIGH);
}

void atras(int vIzq, int vDer) {
  analogWrite(ENA, vIzq); analogWrite(ENB, vDer);
  digitalWrite(IN1, HIGH); digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH); digitalWrite(IN4, LOW);
}

void girarIzquierda(int vIzq, int vDer) {
  analogWrite(ENA, vIzq); analogWrite(ENB, vDer);
  digitalWrite(IN1, HIGH); digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);  digitalWrite(IN4, HIGH);
}

void girarDerecha(int vIzq, int vDer) {
  analogWrite(ENA, vIzq); analogWrite(ENB, vDer);
  digitalWrite(IN1, LOW);  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH); digitalWrite(IN4, LOW);
}

void detener() {
  analogWrite(ENA, 0); analogWrite(ENB, 0);
  digitalWrite(IN1, LOW); digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW); digitalWrite(IN4, LOW);
}
